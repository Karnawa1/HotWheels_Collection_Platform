# ===========================================
# Hot Wheels Platform - Environment Variables
# ===========================================
# Copy this file to .env and fill in your values
# Never commit .env to version control!
# ===========================================

# -----------------------------------------
# Application Settings
# -----------------------------------------
APP_VERSION=1.0.0
FLASK_ENV=development
DEBUG=True
LOG_LEVEL=INFO

# -----------------------------------------
# Security Keys (REQUIRED - Generate secure values!)
# -----------------------------------------
SECRET_KEY=your-super-secret-key-change-in-production
JWT_SECRET_KEY=your-jwt-secret-key-change-in-production
JWT_ACCESS_TOKEN_EXPIRES=86400

# -----------------------------------------
# PostgreSQL Database
# -----------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=hotwheels_db
POSTGRES_USER=hotwheels_admin
POSTGRES_PASSWORD=your-postgres-password-change-me

# -----------------------------------------
# Redis Cache
# -----------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=redis_secure_pass

# -----------------------------------------
# MongoDB
# -----------------------------------------
MONGO_HOST=mongodb
MONGO_PORT=27017
MONGO_DB=hotwheels_media
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=your-mongo-password-change-me

# -----------------------------------------
# API Settings
# -----------------------------------------
API_PORT=5000
API_HOST=0.0.0.0

# -----------------------------------------
# Frontend Settings
# -----------------------------------------
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:5000

# -----------------------------------------
# Nginx (Production)
# -----------------------------------------
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# -----------------------------------------
# Gunicorn (Production)
# -----------------------------------------
GUNICORN_WORKERS=4
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=120

# -----------------------------------------
# Auto Migration
# -----------------------------------------
AUTO_MIGRATE=True
