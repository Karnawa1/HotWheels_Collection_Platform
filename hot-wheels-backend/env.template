# ===========================================
# Hot Wheels Backend - Environment Variables Template
# Copy this file to .env and fill in the values
# ===========================================

# Flask Configuration
FLASK_ENV=development
FLASK_APP=run.py
DEBUG=True
SECRET_KEY=your-super-secret-key-change-in-production

# JWT Configuration
JWT_SECRET_KEY=your-jwt-secret-key-change-in-production
JWT_ACCESS_TOKEN_EXPIRES=86400

# PostgreSQL Database
POSTGRES_DB=hotwheels_db
POSTGRES_USER=hotwheels_admin
POSTGRES_PASSWORD=your-secure-postgres-password
POSTGRES_PORT=5432
DATABASE_URL=postgresql://hotwheels_admin:your-secure-postgres-password@localhost:5432/hotwheels_db

# Redis Cache
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your-secure-redis-password

# MongoDB
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=your-secure-mongo-password
MONGO_DB=hotwheels_media
MONGO_PORT=27017

# API Configuration
API_HOST=0.0.0.0
API_PORT=5000

# Gunicorn
GUNICORN_WORKERS=2
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=120

# Logging
LOG_LEVEL=INFO

# Auto Migration
AUTO_MIGRATE=True

