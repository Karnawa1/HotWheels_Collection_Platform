# ===========================================
# Hot Wheels Platform - Environment Variables
# ===========================================
# Copy this file to .env and fill in the values
# NEVER commit .env to version control!
# ===========================================

# -----------------------------------------
# Application Settings
# -----------------------------------------
APP_VERSION=1.0.0
FLASK_ENV=development
DEBUG=True
SECRET_KEY=your-super-secret-key-change-me-in-production

# -----------------------------------------
# PostgreSQL Database
# -----------------------------------------
POSTGRES_DB=hotwheels_db
POSTGRES_USER=hotwheels_admin
POSTGRES_PASSWORD=secure_password_123
POSTGRES_PORT=5432

# -----------------------------------------
# Redis Cache
# -----------------------------------------
REDIS_PASSWORD=redis_secure_pass
REDIS_PORT=6379

# -----------------------------------------
# MongoDB (Media Storage)
# -----------------------------------------
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=mongo_secure_pass
MONGO_DB=hotwheels_media
MONGO_PORT=27017

# -----------------------------------------
# JWT Authentication
# -----------------------------------------
JWT_SECRET_KEY=jwt-secret-change-me-in-production
JWT_ACCESS_TOKEN_EXPIRES=86400
JWT_REFRESH_TOKEN_EXPIRES=2592000

# -----------------------------------------
# API Server
# -----------------------------------------
API_PORT=5000
LOG_LEVEL=INFO
AUTO_MIGRATE=True

# -----------------------------------------
# Gunicorn (Production Server)
# -----------------------------------------
GUNICORN_WORKERS=4
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=120

# -----------------------------------------
# Optional Settings
# -----------------------------------------
CORS_ORIGIN=*
MAX_CONTENT_LENGTH=16777216
UPLOAD_FOLDER=uploads
